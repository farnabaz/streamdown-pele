{
  "name": "streamdown-pele",
  "version": "0.0.0",
  "description": "Render Streamdown mermaid code blocks with Pele, kepano's fast Mermaid renderer.",
  "type": "module",
  "license": "MIT",
  "author": "Farnabaz <farnabaz@gmail.com>",
  "homepage": "https://github.com/farnabaz/streamdown-pele#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farnabaz/streamdown-pele.git"
  },
  "bugs": "https://github.com/farnabaz/streamdown-pele/issues",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "streamdown",
    "pele",
    "mermaid",
    "diagram",
    "markdown"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "release": "release-it"
  },
  "peerDependencies": {
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "release-it": "^21.1.1",
    "streamdown": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "pele": "^1.6.0"
  }
}
